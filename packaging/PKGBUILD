# Maintainer: DNS Jump Contributors
pkgname=dns-jump
pkgver=0.1.0
pkgrel=1
pkgdesc="Minimal DNS switcher for Linux (NetworkManager), inspired by DNS Jumper"
arch=('x86_64' 'aarch64')
url="https://github.com/DnsJump/dns-jump"
license=('MIT')
depends=('gtk4' 'libadwaita' 'networkmanager' 'gcc-libs' 'glibc')
makedepends=('cargo' 'pkgconf')
optdepends=('systemd: flush DNS cache via resolvectl')
source=("$pkgname-$pkgver.tar.gz::https://github.com/DnsJump/dns-jump/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')
options=('!lto')

prepare() {
  cd "$srcdir/dns-jump-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$srcdir/dns-jump-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release --bin dns-jump
}

package() {
  cd "$srcdir/dns-jump-$pkgver"
  install -Dm755 "target/release/dns-jump" "$pkgdir/usr/bin/dns-jump"
  install -Dm644 "data/dns-jump.desktop" "$pkgdir/usr/share/applications/dns-jump.desktop"
  install -Dm644 "data/icons/hicolor/scalable/apps/io.github.DnsJump.svg" \
    "$pkgdir/usr/share/icons/hicolor/scalable/apps/io.github.DnsJump.svg"
  install -Dm644 "data/io.github.DnsJump.metainfo.xml" \
    "$pkgdir/usr/share/metainfo/io.github.DnsJump.metainfo.xml"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
